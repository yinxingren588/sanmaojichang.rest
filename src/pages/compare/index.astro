---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import { airports } from '../../data/airports';
import { displayPrice, unknown } from '../../lib/airports';
---
<Base title="机场横向比较工具：价格、流量与支持情况｜三毛导航" description="选择 2–4 家机场，对比价格、流量、每 GB 成本、节点地区、协议、设备限制、AI 与流媒体支持。未核实字段明确显示。" noindex={airports.length<2} crumbs={[{name:'机场对比',url:'/compare/'}]}>
<div class="container"><header class="page-intro"><span class="eyebrow">SIDE BY SIDE</span><h1>把候选放在一起，逐项看清区别</h1><p>选择 2–4 家品牌。每一个数字都应能回到资料来源，资料缺失时显示“尚未核实”。</p></header><div class="page-body"><div id="compare-tool" data-airports={JSON.stringify(airports)}><div class="form-row"><div><label for="brand-select">添加候选品牌</label><div class="compare-control"><select id="brand-select" disabled={!airports.length}><option value="">{airports.length?'请选择品牌':'暂无已录入品牌'}</option>{airports.map(a=><option value={a.id}>{a.name}</option>)}</select><button id="add-brand" class="button" disabled={!airports.length}>添加 <span aria-hidden="true">＋</span></button></div></div><button id="clear-brands" class="button secondary" disabled>清空候选</button></div><p id="compare-status" class="live-status" aria-live="polite">{airports.length?'请选择至少 2 家，最多 4 家品牌。':'品牌资料尚未录入，暂时无法添加候选。'}</p><div id="compare-chips" class="compare-chips" aria-label="已选品牌"></div><div id="compare-empty"><EmptyState title="先选候选，再看差异" text="品牌资料正在准备中。录入后可以添加或移除候选，表格会按统一口径更新；未核实套餐不计算成本。"/></div><div id="compare-output" class="table-scroll" aria-label="横向比较结果" tabindex="0" hidden></div></div><noscript><div class="notice">交互比较需要 JavaScript。品牌基本资料可在下方静态表格与资料库中阅读。</div></noscript><section class="section"><h2 class="gap-bottom">品牌基础资料（静态可读）</h2><div class="table-scroll"><table><thead><tr><th>品牌</th><th>月付起价</th><th>地区</th><th>协议</th><th>资料来源</th></tr></thead><tbody>{airports.length?airports.map(a=><tr><td><a href={`/airport/${a.slug}/`}>{a.name}</a></td><td>{displayPrice(a)}</td><td>{a.regions.join('、')||unknown}</td><td>{a.protocols.join('、')||unknown}</td><td><a href={`/airport/${a.slug}/`}>查看核验状态</a></td></tr>):<tr><td colspan="5" class="table-empty">暂无品牌资料</td></tr>}</tbody></table></div></section><h2>比较口径</h2><ul><li>默认比较已核验的 CNY 月付且每月重置套餐；其他套餐请查看品牌资料。</li><li>有效 GB = 标称流量（统一为 GB）÷ 倍率；不同节点倍率需要分别核对。</li><li>AI 与流媒体支持属于有日期的资料，除非明确标注实测，不构成可用性承诺。</li><li>工具不自动打分；同一来源的未知字段不会补全为肯定结果。</li></ul><a class="text-link" href="/blog/cost-per-gb/">了解每 GB 成本 →</a></div></div>
<script>
import { initCompare } from '../../scripts/compare';
initCompare();
</script>
</Base>

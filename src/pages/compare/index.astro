---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import BrandTable from '../../components/BrandTable.astro';
import { airports } from '../../data/airports';

---
<Base title="机场横向比较工具：价格、流量与支持情况｜三毛导航" description="选择 2–4 家机场，对比价格、流量、每 GB 成本、节点地区、协议、设备限制、AI 与流媒体支持。未核实字段明确显示。" noindex={airports.length<2} crumbs={[{name:'机场对比',url:'/compare/'}]}>
<div class="container"><header class="page-intro"><span class="eyebrow">SIDE BY SIDE</span><h1>把候选放在一起，逐项看清区别</h1><p>选择 2–4 家品牌。每一个数字都应能回到资料来源，资料缺失时显示“尚未核实”。</p></header><div class="page-body"><div id="compare-tool" data-airports={JSON.stringify(airports)}><div class="form-row"><div><label for="brand-select">添加候选品牌</label><div class="compare-control"><select id="brand-select" disabled={!airports.length}><option value="">{airports.length?'请选择品牌':'暂无已录入品牌'}</option>{airports.map(a=><option value={a.id}>{a.name}</option>)}</select><button id="add-brand" class="button" disabled={!airports.length}>添加 <span aria-hidden="true">＋</span></button></div></div><button id="clear-brands" class="button secondary" disabled>清空候选</button></div><p id="compare-status" class="live-status" aria-live="polite">{airports.length?'请选择至少 2 家，最多 4 家品牌。':'品牌资料尚未录入，暂时无法添加候选。'}</p><div id="compare-chips" class="compare-chips" aria-label="已选品牌"></div><div id="compare-empty"><EmptyState title="先选候选，再看差异" text="从上方添加至少 2 家品牌，最多 4 家。参考起价保留付款周期说明；完整套餐未核实的品牌不计算每 GB 成本。"/></div><div id="compare-output" class="table-scroll" aria-label="横向比较结果" tabindex="0" hidden></div></div><noscript><div class="notice">交互比较需要 JavaScript。品牌基本资料可在下方静态表格与资料库中阅读。</div></noscript><section class="section"><h2 class="gap-bottom">品牌基础资料（静态可读）</h2><BrandTable brands={airports}/></section><h2>比较口径</h2><ul><li>起价与流量可以展示第三方参考摘要，原始周期说明保留；成本只计算已核验、周期匹配的完整套餐。</li><li>有效 GB = 标称流量（统一为 GB）÷ 倍率；不同节点倍率需要分别核对。</li><li>AI 与流媒体支持属于有日期的资料，除非明确标注实测，不构成可用性承诺。</li><li>工具不自动打分；同一来源的未知字段不会补全为肯定结果。</li></ul><a class="text-link" href="/blog/cost-per-gb/">了解每 GB 成本 →</a></div></div>
<script>
import { initCompare } from '../../scripts/compare';
initCompare();
</script>
</Base>

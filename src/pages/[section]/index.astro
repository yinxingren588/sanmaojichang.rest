---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { sections } from '../../data/site';
import '../../styles/article-directory.css';
import { articleTopics, guideTopics, sortArticles } from '../../lib/article-navigation';
export function getStaticPaths() { return Object.keys(sections).map(section=>({params:{section}})); }
const section = Astro.params.section!; const info = sections[section];
const articles = sortArticles(await getCollection('articles',a=>!a.data.draft && a.data.section===section));
const categories=section==='blog'?['套餐决策','网络知识','使用场景']:section==='guides'?guideTopics:[];
const routes=section==='guides'?[
  {label:'第一次使用',text:'从安装来源、设备指南到首次导入',url:'/guides/subscription-first-import/'},
  {label:'遇到连接问题',text:'先定位失败阶段，再逐项验证',url:'/guides/troubleshooting/'},
  {label:'更新与迁移',text:'保存配置，比较版本，验证恢复',url:'/guides/client-upgrade-rollback/'}
]:section==='blog'?[
  {label:'套餐决策',text:'先看预算、计费周期与有效流量',url:'/blog/budget-checklist/'},
  {label:'网络知识',text:'分清概念、观察与能够支持的结论',url:'/blog/claims-and-evidence/'},
  {label:'使用场景',text:'用自己的真实任务建立检查清单',url:'/blog/trial-checklist/'}
]:[];
---
<Base title={`${info.name}｜三毛导航`} description={info.description} crumbs={[{name:info.name,url:`/${section}/`}]}>
<div class="container"><header class="page-intro directory-intro"><span class="eyebrow">{info.label} / THE READING ROOM</span><h1>{info.name}</h1><p>{info.description}</p><div class="directory-count"><strong>{articles.length}</strong><span>篇文章 · 按问题阅读，循步骤实践</span></div></header><div class="page-body">
{routes.length>0&&<div class="directory-routes" aria-label="建议阅读路线">{routes.map(route=><a href={route.url}><h2>{route.label}<span aria-hidden="true">↗</span></h2><p>{route.text}</p></a>)}</div>}
<section class="article-directory" data-article-directory data-page-size="12" aria-label={`${info.name}目录`}>
  <div class="directory-controls" hidden><div><label for="directory-search">查找文章</label><input id="directory-search" class="search-input" type="search" placeholder={section==='guides'?'输入设备或问题，如：Windows、导入、DNS':'输入主题，如：年付、DNS、会议、备份'} autocomplete="off"/></div>{categories.length>0&&<div class="directory-topics" aria-label="文章专题筛选"><button type="button" data-directory-category="" aria-pressed="true">全部 <span>{articles.length}</span></button>{categories.map(category=><button type="button" data-directory-category={category} aria-pressed="false">{category} <span>{articles.filter(a=>articleTopics(a).includes(category)).length}</span></button>)}</div>}</div>
  <p id="directory-status" class="directory-status" aria-live="polite">全部 {articles.length} 篇文章</p>
  <div id="directory-results" class="article-grid directory-entries">{articles.map(a=><div data-directory-item data-directory-search={`${a.data.title} ${a.data.description} ${a.data.tags.join(' ')}`} data-directory-topics={articleTopics(a).join('|')}><ArticleCard article={a}/></div>)}</div>
  <p class="directory-empty" hidden>没有找到匹配的文章。可以缩短关键词，或选择“全部”专题继续查找。</p>
  <nav class="directory-pages" aria-label="文章目录分页" hidden></nav>
  <noscript><p class="notice">上方列出全部文章，可直接阅读；启用 JavaScript 后可使用专题筛选、关键词搜索与分页。</p></noscript>
</section>
<div class="notice">遇到具体连接问题，可先阅读<a class="text-link" href="/guides/troubleshooting/">分层排查教程</a>；准备比较品牌时，前往<a class="text-link" href="/airport/">品牌资料库</a>核对来源与套餐条件。</div>
</div></div>
<script>
import '../../scripts/article-directory';
</script>
</Base>

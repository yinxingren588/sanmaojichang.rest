---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import '../../styles/article-content.css';
import { sections, SITE, topics } from '../../data/site';
import { articleUrl, directoryUrl, readingNavigation } from '../../lib/article-navigation';
export async function getStaticPaths() {
  return (await getCollection('articles',a=>!a.data.draft)).map(entry=>({params:{section:entry.data.section,slug:entry.data.slug},props:{entry}}));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const a = entry.data; const info = sections[a.section];
const { topic, topicCount, sequenceTopic, series, position, previous, next, related } = readingNavigation(entry, await getCollection('articles',b=>!b.data.draft));
const readingDirectory = a.section==='blog' ? directoryUrl(entry) : `/${a.section}/`;
const relatedTopic = topics.find(t=>t.related.includes(a.slug))||topics[2];
const schema = [{'@context':'https://schema.org','@type':a.section==='blog'?'BlogPosting':'Article',headline:a.title,description:a.description,datePublished:a.published,dateModified:a.updated,inLanguage:'zh-CN',mainEntityOfPage:`${SITE.domain}/${a.section}/${a.slug}/`,author:{'@type':'Organization',name:SITE.name,url:`${SITE.domain}/about/`},publisher:{'@id':`${SITE.domain}/#organization`}}];
---
<Base title={`${a.title}｜三毛导航`} description={a.description} type="article" crumbs={[{name:info.name,url:`/${a.section}/`},{name:a.title,url:`/${a.section}/${a.slug}/`}]} schema={schema}>
<div class="container" id="article-top">
  <header class="page-intro"><span class="eyebrow">{info.label} / {a.tags[0]}</span><h1>{a.title}</h1><p>{a.description}</p></header>
  <div class="article-meta"><span>撰写：三毛导航</span><span>发布 <time datetime={a.published}>{a.published}</time></span><span>更新 <time datetime={a.updated}>{a.updated}</time></span><span>资料类型：编辑整理</span></div>
  <nav class="reading-toolbar" aria-label="文章快捷导航">
    <a href={`/${a.section}/`}>← {info.name}目录</a>
    {topic&&<a href={directoryUrl(entry)}>{topic} · 全部 {topicCount} 篇 ↗</a>}
    <a href="#continue-reading">接着读 ↓</a>
  </nav>
  <details class="reading-mobile-contents"><summary>本文目录 · 点击展开</summary><nav aria-label="手机文章目录">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></details>
  <div class="content-layout">
    <article class="prose"><Content/><div class="source-list"><h2>参考来源与阅读说明</h2><p>以下为技术概念或软件行为的官方参考。操作界面可能随版本变化；本文未包含品牌实测或套餐承诺。</p><ul>{a.sources.map(url=><li><a href={url} rel="noopener noreferrer" target="_blank">{url}</a></li>)}</ul><p>发现错误？请通过<a href="/contact/">联系与纠错</a>页面提交证据。</p></div></article>
    <aside class="article-aside">
      <nav aria-label="本文目录"><h2>本文目录</h2>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav>
      <div class="reading-aside-series"><h2>{sequenceTopic||info.name} · 连续阅读</h2><p>第 {position+1} / {series.length} 篇</p>
        {next?<a href={articleUrl(next)}><span>下一篇 →</span>{next.data.title}</a>:<a href={readingDirectory}>已读到最后一篇，返回目录 →</a>}
        <a href="#continue-reading">查看相关内容 ↓</a>
      </div>
      <hr style="border:0;border-top:1px solid #e3e9f1;margin:22px 0"/><h2>继续探索</h2><a href={`/recommend/${relatedTopic.slug}/`}>{relatedTopic.name}选择专题 →</a><a href="/glossary/">术语解释 →</a><a href="/guides/troubleshooting/">连接排查 →</a>
    </aside>
  </div>
  <section class="reading-continuation" id="continue-reading" aria-labelledby="continue-title">
    <div class="reading-section-heading"><div><span class="eyebrow">KEEP READING</span><h2 id="continue-title">接着读</h2><p>{sequenceTopic||info.name} · 第 {position+1} / {series.length} 篇</p></div><a class="text-link" href={readingDirectory}>浏览{sequenceTopic||info.name}目录 →</a></div>
    <nav class="reading-sequence" aria-label="上一篇和下一篇">
      {previous?<a href={articleUrl(previous)} rel="prev"><span>← 上一篇</span><strong>{previous.data.title}</strong></a>:<a href={readingDirectory}><span>从这里开始</span><strong>这是第一篇，浏览全部文章 →</strong></a>}
      {next?<a href={articleUrl(next)} rel="next"><span>下一篇 →</span><strong>{next.data.title}</strong></a>:<a href={readingDirectory}><span>已读到最后一篇</span><strong>返回目录，挑选下一个阅读主题 →</strong></a>}
    </nav>
    <div class="reading-section-heading reading-related-heading"><h2>你可能还想了解</h2><a class="text-link" href="#article-top">返回文章顶部 ↑</a></div>
    <div class="article-grid">{related.map(b=><ArticleCard article={b}/>)}</div>
    <nav class="reading-library-links" aria-label="更多文章入口"><a href="/guides/">使用教程 · 逐步实践 →</a><a href="/blog/">博客文章 · 深入阅读 →</a><a href="/glossary/">术语百科 · 查清概念 →</a></nav>
  </section>
</div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ArticleCard from '../components/ArticleCard.astro';
import AirportCard from '../components/AirportCard.astro';
import EmptyState from '../components/EmptyState.astro';
import BrandTable from '../components/BrandTable.astro';
import { topics } from '../data/site';
import { airports } from '../data/airports';

const articles = (await getCollection('articles',a=>!a.data.draft)).sort((a,b)=>b.data.updated.localeCompare(a.data.updated)||a.id.localeCompare(b.id));
const blogs = articles.filter(a=>a.data.section==='blog');

const selected = airports;
const coupons=airports.filter(a=>a.coupon);
const reviews = airports.filter(a=>a.reviewPublished && a.testStatus==='tested');
const faqs = [
 ['三毛导航与三毛机场是什么关系？','三毛导航是以三毛机场等订阅服务为主题的独立内容博客。本站不销售订阅，也不代表任何服务商；品牌资料会在来源核验后发布。'],
 ['新手应该怎样选择机场？','先确认地址来源、设备支持与预算，再核对短周期套餐。把客户端安装、订阅导入和一次实际使用走完整，比只看营销参数更有帮助。'],
 ['品牌价格与优惠码来自哪里？','29 个品牌入口与 12 个优惠码由维护者提供，28 个品牌参考摘要来自第三方参考站。年付折算和未知流量周期保留说明；这些摘要不属于本站实测，也不进入自动成本排名。'],
 ['机场每 GB 成本怎么计算？','先把标称流量除以适用倍率，得到有效流量，再用套餐价格除以有效流量。不同计费周期、流量单位和币种必须分组比较。'],
 ['专线、低延迟或 AI 解锁能保证体验吗？','不能。线路标签、一次测速和官方宣传不能替代实际环境验证。地区、设备、运营商、账号及平台规则都可能影响体验。'],
 ['在哪里查看信息来源和更新日期？','文章标题下方标注发布日期和更新日期，文末列出参考来源。品牌资料与实测记录单独标注核验状态，纠错可前往联系页面。']
];
---
<Base title="三毛机场博客与机场推荐指南｜三毛导航" description="三毛导航提供三毛机场主题资讯、机场推荐选择指南、套餐成本比较、客户端教程与知识百科。资料按来源核验，不虚构价格、排名或测速。">
<section class="hero"><div class="container hero-inner"><div><div class="eyebrow"><span class="pill">独立视角 · 有据可查</span> THE SANMAO JOURNAL</div><h1>三毛机场博客<br/>让每一次选择，<em>更有依据。</em></h1><p>读懂套餐，分清线路，找到适合自己的使用方式。<br/>从机场推荐到客户端教程，把复杂的信息讲清楚。</p><div class="hero-buttons"><a class="button" href="/recommend/">探索机场推荐 <Icon size={17}/></a><a class="button secondary" href="/guides/">从新手教程开始</a></div><div class="hero-fine"><Icon name="shield" size={15}/> 资料来源透明 · 核验状态公开 · 不制造评分</div></div><aside class="hero-panel" aria-label="新手阅读路径"><div class="panel-header"><span>START HERE / 从这里开始</span><span class="status-dot">阅读路线</span></div><h2>第一次选择机场？<br/>先看这三个问题。</h2>{[['01','我需要多少流量？','按实际用量选择，留出合理余量。','/blog/budget-checklist/'],['02','套餐真的划算吗？','把周期、流量和倍率放在一起算。','/blog/cost-per-gb/'],['03','买之前要确认什么？','核对来源，短期验证，再做决定。','/blog/trial-checklist/']].map(([n,t,d,url])=><a class="decision-row" href={url}><span class="step-num">{n}</span><div><h3>{t}</h3><p>{d}</p></div><Icon size={17}/></a>)}</aside></div></section>
<div class="container trust-strip"><span><Icon name="book" size={17}/> 原创选择指南</span><span><Icon name="shield" size={17}/> 来源与状态披露</span><span><Icon name="compare" size={17}/> 统一口径比较</span><span><Icon name="clock" size={17}/> 标明内容更新日期</span></div>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">THE QUICK ANSWER</span><h2>先给你一个清晰的答案</h2></div><a class="text-link" href="/recommend/beginner/">新手选择指南 →</a></div><div class="quick-grid">{[
 ['01','新手，从短周期开始','先看设备支持与帮助文档，用短期方案验证自己的环境。','/recommend/beginner/'],['02','价格，看实际支付','月付、年付、不限时分别算，别只看“低至每月”。','/blog/budget-checklist/'],['03','流量，记得看倍率','有效流量与重置周期，决定套餐能用多久。','/blog/cost-per-gb/'],['04','购买前，核对来源','确认真实地址、退款条件，保留当期套餐说明。','/blog/verify-address/']
].map(([n,t,p,u])=><article class="quick-card"><span class="num">{n} /</span><h3>{t}</h3><p>{p}</p><a class="text-link" href={u}>了解更多 →</a></article>)}</div></div></section>
<section class="section soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">EDITOR'S SELECTION</span><h2>品牌资料，先看价格与流量</h2><p>已录入 29 个品牌入口；价格、流量与优惠码标明来源。</p></div><a class="text-link" href="/airport/">全部品牌资料 →</a></div>{selected.length?<div class="airport-grid">{selected.slice(0,6).map(a=><AirportCard airport={a}/>)}</div>:<EmptyState/>}<p class="section-note"><Icon name="shield" size={14}/> 参数为第三方参考摘要；品牌入口含推广关系，当前条件请以下单页为准。</p></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">BRANDS AT A GLANCE</span><h2>29 个品牌 · 价格与流量速览</h2><p>保留参考站起步报价原文，年付折算与流量周期分别注明。</p></div><a class="text-link" href="/compare/">选择品牌对比 →</a></div><BrandTable brands={airports}/><p class="section-note">第三方参考资料采集于 2026-10-19，非官网已核实报价，非本站实测。完整套餐与倍率尚未核实，不参与自动成本排名。<a href="/ranking/">查看排名规则 →</a></p></div></section>
<section class="section soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">SAVE YOUR CODE</span><h2>12 个品牌优惠码</h2><p>保留大小写，结算时确认适用条件与最终应付金额。</p></div><a class="text-link" href="/coupons/">复制优惠码 →</a></div><div class="coupon-preview-row">{coupons.map(a=><a href={`/airport/${a.slug}/`}>{a.name}<code>{a.coupon!.code}</code></a>)}</div></div></section>
<section class="section soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">FIND YOUR FIT</span><h2>按需求选择，不必从头研究</h2></div><span class="eyebrow"><span>6 个选择方向</span></span></div><div class="topic-grid">{topics.map(t=><a class="topic-card" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.icon}</span><div><h3>{t.name}</h3><p>{t.desc}</p></div><Icon size={17}/></a>)}</div><div class="compare-band"><div><span class="eyebrow">SIDE BY SIDE</span><h3>放在一起，区别更清楚。</h3><p>选择 2–4 家品牌，从价格、流量到支持情况逐项对照。</p></div><a class="button" href="/compare/">打开机场对比 <Icon size={17}/></a></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">IN-DEPTH REVIEWS</span><h2>独立评测，不止于参数</h2><p>官方资料、编辑整理与实测结论，清晰分开。</p></div><a class="text-link" href="/review/">评测方法 →</a></div>{reviews.length?<div class="airport-grid">{reviews.map(a=><AirportCard airport={a}/>)}</div>:<EmptyState title="有记录，才有评测结论" text="暂未发布实测文章。完成环境记录、套餐核验与实际测试后，才会在这里展示独立评测。"/>}</div></section>
<section class="section soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">GET CONNECTED</span><h2>教程中心 · 从你的设备开始</h2></div><a class="text-link" href="/guides/">全部教程 →</a></div><div class="guides-grid">{[['windows','⊞','Windows','安装来源、导入订阅与系统代理检查'],['android','◈','Android','应用权限、VPN 连接与后台运行'],['ios','◉','iOS / iPadOS','商店来源、配置授权与连接状态'],['macos','⌘','macOS','安全授权、订阅更新与网络排查']].map(([slug,icon,name,d])=><a class="guide-card" href={`/guides/${slug}/`}><span class="os-symbol" aria-hidden="true">{icon}</span><h3>{name} 使用指南</h3><p>{d}</p><span class="text-link">查看教程 →</span></a>)}</div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div><span class="eyebrow">KNOW THE BASICS</span><h2>读懂这些词，选择更从容</h2></div><a class="text-link" href="/glossary/">知识百科 →</a></div><div class="glossary-links">{[['subscription','订阅链接','SUBSCRIPTION'],['traffic-multiplier','流量倍率','TRAFFIC MULTIPLIER'],['latency','延迟与速度','LATENCY & SPEED'],['iplc-iepl','IPLC / IEPL','PRIVATE CIRCUITS'],['split-routing','规则分流','RULE-BASED ROUTING']].map(([slug,name,en])=><a href={`/glossary/${slug}/`}>{name}<small>{en}</small></a>)}</div></div></section>
<section class="section soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">LATEST IN THE JOURNAL</span><h2>最新文章 · 把问题讲明白</h2></div><a class="text-link" href="/blog/">阅读全部文章 →</a></div><div class="article-grid">{blogs.slice(0,3).map(a=><ArticleCard article={a}/>)}</div></div></section>
<section class="section"><div class="container faq-layout"><div class="faq-intro"><span class="eyebrow">A FEW MORE ANSWERS</span><h2 style="margin-top:10px">你可能还想了解</h2><p>关于三毛导航、机场推荐与资料核验的常见问题。</p><a class="text-link" href="/contact/">反馈与纠错 →</a></div><div class="faq-list">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
</Base>

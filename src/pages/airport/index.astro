---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import AirportCard from '../../components/AirportCard.astro';
import { airports } from '../../data/airports';
---
<Base title="机场品牌资料库｜三毛导航" description="机场品牌资料统一记录套餐、协议、地区、支持情况和来源，按核验状态公开；没有证据的字段显示尚未核实。" noindex={airports.length===0} crumbs={[{name:'品牌资料库',url:'/airport/'}]}><div class="container"><header class="page-intro"><span class="eyebrow">BRAND DIRECTORY</span><h1>品牌资料库</h1><p>已录入 29 个品牌、28 份第三方参考摘要与 12 个优惠码。品牌入口含推广关系，参数非本站实测。</p></header><div class="page-body"><div class="brand-stats"><span>29 个品牌</span><span>28 份参考摘要</span><span><a href="/coupons/">12 个优惠码 →</a></span></div><label class="brand-search-label" for="brand-search">查找品牌或优惠码</label><input id="brand-search" class="search-input" type="search" placeholder="输入品牌名称或优惠码"/><p id="brand-filter-status" class="brand-filter-status" aria-live="polite">全部 29 个品牌</p>{airports.length?<div class="airport-grid">{airports.map(a=><AirportCard airport={a}/>)}</div>:<EmptyState title="品牌资料等待录入" text="站点维护者确认品牌与官网后，再逐项核验套餐、地区、设备限制和支持情况。当前未填入示例品牌。"/>}</div></div><script>
const input=document.querySelector<HTMLInputElement>('#brand-search')!;
const cards=[...document.querySelectorAll<HTMLElement>('[data-brand-search]')];
input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let n=0;cards.forEach(c=>{c.hidden=!c.dataset.brandSearch!.toLowerCase().includes(q);if(!c.hidden)n++;});document.querySelector('#brand-filter-status')!.textContent=`找到 ${n} 个品牌`;});
</script></Base>

---
import Base from '../../layouts/Base.astro';
import { airports } from '../../data/airports';
import { displayPrice, unknown, costPerGB } from '../../lib/airports';
export function getStaticPaths(){return airports.map(airport=>({params:{slug:airport.slug},props:{airport}}));}
const {airport:a}=Astro.props;
---
<Base title={`${a.name}资料：套餐、线路与核验状态｜三毛导航`} description={a.description} noindex={a.testStatus==='unverified'} crumbs={[{name:'品牌资料库',url:'/airport/'},{name:a.name,url:`/airport/${a.slug}/`}]}><div class="container"><header class="page-intro"><span class="eyebrow">BRAND PROFILE</span><h1>{a.name}品牌资料</h1><p>{a.description}</p><span class="pill">{a.testStatus==='tested'?'存在实测记录':a.testStatus==='official-data'?'官方资料整理':'尚未核实'}</span></header><div class="page-body prose narrow"><h2>基本信息</h2><dl><dt>官网</dt><dd>{a.officialUrl?<a href={a.officialUrl} rel="noopener noreferrer" target="_blank">查看已核对来源</a>:unknown}</dd><dt>月付起价</dt><dd>{displayPrice(a)}</dd><dt>协议</dt><dd>{a.protocols.join('、')||unknown}</dd><dt>地区</dt><dd>{a.regions.join('、')||unknown}</dd><dt>线路</dt><dd>{a.routeType||unknown}</dd><dt>设备限制</dt><dd>{a.deviceLimit||unknown}</dd><dt>AI 支持</dt><dd>{a.aiSupport?.join('、')||unknown}</dd><dt>流媒体支持</dt><dd>{a.streamingSupport?.join('、')||unknown}</dd></dl><h2>套餐资料</h2><div class="table-scroll"><table><thead><tr><th>套餐</th><th>价格 / 计费周期</th><th>流量 / 重置周期</th><th>倍率</th><th>有效每 GB 成本</th><th>来源</th></tr></thead><tbody>{a.plans.length?a.plans.map(p=><tr><td>{p.name}</td><td>{p.verified?`${p.currency} ${p.price} / ${p.billing==='monthly'?'月付':p.billing==='yearly'?'年付':'一次性'}`:unknown}</td><td>{p.verified?`${p.trafficGB} ${p.trafficUnit} / ${p.trafficPeriod==='month'?'每月':p.trafficPeriod==='year'?'每年':'总额'}`:unknown}</td><td>{p.verified?p.multiplier:unknown}</td><td>{costPerGB(p)?.toFixed(4)??unknown}</td><td>{p.source?<a href={p.source} target="_blank" rel="noopener noreferrer">套餐来源</a>:unknown}</td></tr>):<tr><td colspan="6">尚未核实套餐</td></tr>}</tbody></table></div><h2>优点与注意事项</h2><p>优点：{a.advantages.join('；')||unknown}</p><p>注意：{a.disadvantages.join('；')||unknown}</p><p>适合人群：{a.suitableFor.join('、')||unknown}</p><h2>核验说明与来源</h2><p>最后核验：{a.lastVerified||unknown}。官方资料不等于实测承诺。</p><ul>{a.sources.map(s=><li><a href={s} rel="noopener noreferrer" target="_blank">{s}</a></li>)}</ul>{a.affiliateUrl&&<p>商业关系披露：此品牌存在推广链接，点击或购买可能产生佣金。<a href={a.affiliateUrl} rel="sponsored noopener noreferrer" target="_blank">前往服务商（推广）</a></p>}<p><a href="/compare/">加入对比工具</a>{a.reviewPublished&&<> · <a href={`/review/${a.slug}/`}>阅读独立评测</a></>}</p></div></div></Base>

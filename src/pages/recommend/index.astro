---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import EmptyState from '../../components/EmptyState.astro';
import AirportCard from '../../components/AirportCard.astro';
import { topics } from '../../data/site';
import { airports } from '../../data/airports';
const verified=airports.filter(a=>a.referenceOffer || a.testStatus!=='unverified');
---
<Base title="机场推荐怎么选：六类需求与购买前检查｜三毛导航" description="按低预算、高端专线、新手入门、稳定性、AI 和流媒体需求选择机场。先讲核验依据，再查看品牌资料，不用虚构评分替你做决定。" crumbs={[{name:'机场推荐',url:'/recommend/'}]}>
<div class="container"><header class="page-intro"><span class="eyebrow">CHOOSE WITH CONTEXT</span><h1>机场推荐，先从你的需求出发</h1><p>没有适合所有人的方案。先确认预算、设备与使用场景，再比较套餐、线路和证据。</p></header><div class="page-body"><div class="topic-grid">{topics.map(t=><a class="topic-card" href={`/recommend/${t.slug}/`}><span class="topic-icon">{t.icon}</span><div><h2 style="font-size:18px">{t.name}</h2><p>{t.desc}</p></div><Icon size={17}/></a>)}</div><section class="section"><h2 class="gap-bottom">先建立自己的选择清单</h2><ol class="flow-steps"><li>写下设备、主要应用、每月用量与支出上限。</li><li>核实官方来源、付款周期、流量规则与退款条件。</li><li>在自己的设备与网络下完成短期验证，记录问题。</li><li>将候选加入<a class="text-link" href="/compare/">比较工具</a>，逐项核对，保留购买时的资料。</li></ol></section><h2 class="gap-bottom">品牌资料与参考方案</h2>{verified.length?<div class="airport-grid">{verified.map(a=><AirportCard airport={a}/>)}</div>:<EmptyState/>}<div class="notice">推荐依据详见<a class="text-link" href="/editorial-policy/">编辑政策</a>；预算与成本计算请阅读<a class="text-link" href="/blog/cost-per-gb/">每 GB 成本指南</a>。</div></div></div>
</Base>

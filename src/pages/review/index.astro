---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import { airports } from '../../data/airports';
const reviews=airports.filter(a=>a.reviewPublished&&a.testStatus==='tested'&&a.stability);
---
<Base title="机场独立评测与测试方法｜三毛导航" description="独立机场评测分别展示官方资料、编辑整理、实际测试与尚未核实项目，公开环境、时间和限制，不用宣传参数替代测试结论。" noindex={reviews.length===0} crumbs={[{name:'机场评测',url:'/review/'}]}><div class="container"><header class="page-intro"><span class="eyebrow">EVIDENCE BEFORE OPINIONS</span><h1>独立评测，让结论有来处</h1><p>一次测速无法代表长期表现。评测应有测试环境、时间、原始记录与限制说明。</p></header><div class="page-body">{reviews.length?reviews.map(a=><a class="article-card" href={`/review/${a.slug}/`}><h2>{a.name}独立评测</h2><p>{a.description}</p></a>):<EmptyState title="当前没有已发布的实测评测" text="收到品牌并完成测试后发布。本站不会把官方宣传改写成“亲测”或虚构测速图。"/>}<div class="method-list"><article><h2>01 / 官方公开资料</h2><p>套餐、线路说明和使用限制，保留来源及核验日期。明确“服务商声称”与适用条件。</p></article><article><h2>02 / 编辑整理</h2><p>统一周期与单位，解释条款；对无法交叉验证的字段标注尚未核实，不做推断补全。</p></article><article><h2>03 / 实际测试</h2><p>注明设备、网络、地区、节点、日期、方法与样本。只在证据覆盖的范围内作出结论。</p></article></div><h2>购买前可自行做的检查</h2><p style="margin-top:16px">保存当前套餐说明，短期验证导入、更新、访问与关闭代理。具体记录方法见<a class="text-link" href="/blog/trial-checklist/">试用检查清单</a>。</p><p>更多说明见<a class="text-link" href="/editorial-policy/">编辑政策</a>与<a class="text-link" href="/ranking/stable/">稳定性榜规则</a>。</p></div></div></Base>

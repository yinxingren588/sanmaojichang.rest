---
import Base from '../../layouts/Base.astro';
import EmptyState from '../../components/EmptyState.astro';
import BrandTable from '../../components/BrandTable.astro';
import { SITE, rankingTypes } from '../../data/site';
import { airports } from '../../data/airports';
import { rankingEntries, verifiedPlans, costPerGB, unknown } from '../../lib/airports';
export function getStaticPaths(){return rankingTypes.map(r=>({params:{slug:r.slug},props:{ranking:r}}));}
const {ranking:r}=Astro.props;
const rows=rankingEntries(airports,r.slug);
// Keep a separate, repeatable display order for each category; the overall page is unchanged.
const referenceBrands=[...airports];
if(r.slug!=='overall'){
  const first=referenceBrands.findIndex(a=>a.id==='invisible');
  const pinned=first>=0?referenceBrands.splice(first,1):[];
  let seed=[...r.slug].reduce((value,char)=>Math.imul(value,31)+char.charCodeAt(0)>>>0,20261019);
  for(let i=referenceBrands.length-1;i>0;i--){
    seed=(Math.imul(seed,1664525)+1013904223)>>>0;
    const j=Math.floor(seed/4294967296*(i+1));
    [referenceBrands[i],referenceBrands[j]]=[referenceBrands[j],referenceBrands[i]];
  }
  referenceBrands.unshift(...pinned);
}
const schema=rows.length?[{'@context':'https://schema.org','@type':'ItemList',name:r.name,itemListElement:rows.map((a,i)=>({'@type':'ListItem',position:i+1,name:a.name,url:`${SITE.domain}/airport/${a.slug}/`}))}]:[];
---
<Base title={`${r.name}：规则、候选资料与来源｜三毛导航`} description={`${r.description}${r.rule}`} noindex={rows.length===0} schema={schema} crumbs={[{name:'机场排行',url:'/ranking/'},{name:r.name,url:`/ranking/${r.slug}/`}]}>
<div class="container"><header class="page-intro"><span class="eyebrow">TRANSPARENT COMPARISONS / {r.slug}</span><h1>{r.name}</h1><p>{r.description}</p><span class="pill">{rows.length?'已核验候选':'参考资料已录入 · 未发布名次'}</span></header><div class="page-body"><h2>快速结论</h2><p style="margin-top:15px">{rows.length?'下列候选按公开口径整理，结论只适用于标注的资料与时间。':'当前没有满足数据准入条件的品牌，暂时无法给出排名。先核对规则，再比较候选，避免把未经核实的表格当作购买依据。'}</p><div class="notice"><strong>排名依据</strong><p>{r.rule}</p></div><p>默认比较 CNY 月付、每月重置套餐。其他周期、币种与流量周期应单独成组，不能跨组比较。</p><div class="table-scroll"><table><caption class="sr-only">{r.name}已核验候选</caption><thead><tr><th>{r.slug==='overall'?'展示序号':'排名'}</th><th>品牌</th><th>套餐与周期</th><th>标称流量 / 倍率</th><th>每 GB 成本</th><th>适合人群</th><th>核验日期</th></tr></thead><tbody>{rows.length?rows.map((a,i)=>{const plan=verifiedPlans(a).filter(p=>p.billing==='monthly'&&p.trafficPeriod==='month'&&p.currency==='CNY').sort((x,y)=>r.slug==='value'?costPerGB(x)!-costPerGB(y)!:x.price-y.price)[0];return <tr><td>{i+1}</td><td><a href={`/airport/${a.slug}/`}>{a.name}</a></td><td>{plan.name} · {plan.currency} {plan.price}/月</td><td>{plan.trafficGB} {plan.trafficUnit} / {plan.multiplier}×</td><td>{costPerGB(plan)?.toFixed(4)} {plan.currency}</td><td>{a.suitableFor.join('、')||unknown}</td><td>{a.lastVerified}</td></tr>}):<tr><td colspan="7" class="table-empty">暂无已核验数据</td></tr>}</tbody></table></div><section class="section">{rows.length?rows.map(a=><article style="margin-bottom:25px"><h2>{a.name}</h2><p>{a.description}</p><p>适合人群：{a.suitableFor.join('、')||unknown}</p><a class="text-link" href={`/airport/${a.slug}/`}>品牌资料 →</a>{a.reviewPublished&&<a class="text-link" style="margin-left:20px" href={`/review/${a.slug}/`}>独立评测 →</a>}</article>):<EmptyState title="核验完成后，品牌简介与相关评测会显示在这里" text="未录入的品牌、未公开的套餐以及没有来源的价格，都不会进入榜单。"/>}</section><section class="section"><h2>已收录参考资料（不参与排名）</h2><p>下列起价与流量来自第三方摘要或维护者补充，完整套餐及倍率尚未核实，不能据此发布性价比或稳定性排名。</p>{r.slug!=='overall'&&<p class="section-note">展示顺序由编辑调整：隐形人固定首位，其余品牌打散展示；不代表成本或稳定性评分。</p>}<aside class="editor-placement" aria-label="编辑推荐说明"><strong>编辑推荐位 · 隐形人</strong><p>优先展示已收录起价、流量和优惠码的隐形人，方便作为比较起点。此位置由编辑设置，不是测速或稳定性第一名；价格、周期及适用条件请查看品牌资料。</p><a class="text-link" href="/airport/invisible/">查看推荐依据与资料来源 →</a></aside><BrandTable brands={referenceBrands} featuredId="invisible"/></section><h2>更新时间与数据来源</h2><p style="margin-top:15px">规则发布于 <time datetime={SITE.published}>{SITE.published}</time>。{rows.length?'具体品牌来源见各品牌资料页。':'暂无品牌数据核验日期；不以页面构建时间冒充核验时间。'}</p><ul>{rows.map(a=><li><a class="text-link" href={`/airport/${a.slug}/`}>{a.name} · 来源与核验日期</a></li>)}</ul><p>了解<a class="text-link" href="/editorial-policy/">编辑政策</a>，或打开<a class="text-link" href="/compare/">机场对比</a>。</p></div></div></Base>

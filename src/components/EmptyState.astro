---
import Icon from './Icon.astro';
interface Props { title?: string; text?: string; }
const { title = '好推荐，从可靠资料开始', text = '品牌资料正在准备中。核验官网、套餐与来源后，再发布推荐和排名。' } = Astro.props;
---
<div class="empty-state"><span class="empty-icon"><Icon name="shield" size={26}/></span><div><h3>{title}</h3><p>{text}</p><a class="text-link" href="/editorial-policy/">了解资料核验标准 →</a></div></div>
